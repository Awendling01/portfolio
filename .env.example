# Copy to .env.local and fill in the values you need.
# Every integration degrades gracefully if its vars are missing.

# --- Database (visit log, contact-form messages, login attempts) ---
# Neon Postgres connection string. The code accepts any of:
#   DATABASE_URL  (manual setup)
#   POSTGRES_URL  (auto-injected by the Vercel ↔ Neon integration)
#   POSTGRES_URL_NON_POOLING
# Set one. For Vercel, the Neon integration sets POSTGRES_URL automatically.
DATABASE_URL=

# --- Admin auth ---
# A long random string. The cookie session HMAC is derived from this, so
# changing it invalidates every active admin session.
# Generate with: openssl rand -base64 24
ADMIN_PASSWORD=

# --- Visitor IP hashing ---
# Optional but recommended. HMAC key for hashing visitor IPs before they
# touch the database. If unset, falls back to ADMIN_PASSWORD (rotating the
# password then also rotates IP hashes — usually fine).
# Generate with: openssl rand -hex 32
VISIT_HASH_SECRET=

# --- Contact-form email (Resend) ---
# Create at https://resend.com — fine to use the onboarding sender for testing.
RESEND_API_KEY=
# Optional. Defaults to "Portfolio <onboarding@resend.dev>". Use a verified
# domain sender once your DNS is set up at Resend.
RESEND_FROM_EMAIL=

# --- IP enrichment (IPinfo Lite, free tier) ---
# Sign up at https://ipinfo.io — free 50k lookups/month, no card required.
# Without this, visits still log but org/ASN columns stay empty.
IPINFO_TOKEN=

# --- Google Search Console (admin analytics page) ---
# 1. Verify the site at https://search.google.com/search-console
# 2. Create a Google Cloud service account, enable the Search Console API
# 3. Download the JSON key, paste the entire JSON below as one string
# 4. Add the service account email as a Restricted user on the property
GOOGLE_SERVICE_ACCOUNT_KEY=
# The exact site URL as configured in Search Console (trailing slash matters
# for URL-prefix properties).
SEARCH_CONSOLE_SITE_URL=

# --- Future integrations (planned, not yet wired up) ---

# GitHub pinned repos
GITHUB_TOKEN=

# Spotify now-playing widget
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
